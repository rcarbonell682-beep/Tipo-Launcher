<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="48dp"
        android:paddingRight="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="#FFFFFF"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/favorites"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="buscar"
            android:textColor="#888888"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="32dp"
        android:paddingRight="32dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="end"
            android:hint="buscar"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="28sp" />

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:cacheColorHint="#00000000"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingTop="48dp"
            android:paddingRight="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/opt_stats"
                style="@style/PanelInfo" />

            <TextView
                android:id="@+id/opt_shizuku"
                style="@style/PanelInfo"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/opt_4g"
                style="@style/PanelItem"
                android:text="forzar 4G" />

            <TextView
                android:id="@+id/opt_compile"
                style="@style/PanelItem"
                android:text="optimizar apps" />

            <TextView
                android:id="@+id/opt_kill"
                style="@style/PanelItem"
                android:text="cerrar apps" />

            <TextView
                android:id="@+id/opt_cache"
                style="@style/PanelItem"
                android:text="limpiar caché" />

            <TextView
                android:id="@+id/opt_block"
                style="@style/PanelItem"
                android:text="bloquear segundo plano" />

            <TextView
                android:id="@+id/opt_bloat"
                style="@style/PanelItem"
                android:text="bloatware" />

            <TextView
                android:id="@+id/opt_eco"
                style="@style/PanelItem" />

            <TextView
                android:id="@+id/opt_protected"
                style="@style/PanelItem"
                android:text="apps protegidas" />

            <TextView
                android:id="@+id/opt_log"
                style="@style/PanelInfo"
                android:fontFamily="monospace"
                android:paddingTop="24dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/opt_close"
                style="@style/PanelItem"
                android:paddingTop="24dp"
                android:text="cerrar"
                android:textColor="#888888" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
